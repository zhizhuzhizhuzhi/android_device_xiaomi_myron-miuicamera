+
+    move-result v4
+
+    if-eqz v4, :check_optical_slider
+
+    move v3, v13
+
+    goto :goto_0
+
+    :check_optical_slider
     invoke-virtual/range {p0 .. p0}, LZ3/l;->H5()Z
 
     move-result v3
