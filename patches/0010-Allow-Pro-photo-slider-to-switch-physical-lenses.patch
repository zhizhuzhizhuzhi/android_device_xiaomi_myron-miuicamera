+
+    move-result v1
+
+    if-eqz v1, :original_zoom_action
+
+    invoke-static {p0, p3}, Lcom/android/camera/compat/ProPhotoZoom;->switchLens(Lc8/A;F)Z
+
+    move-result v1
+
+    return v1
+
+    :original_zoom_action
     const/4 p2, 0x2
 
     if-eq p1, p2, :cond_3
